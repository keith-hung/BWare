<Window x:Class="BWare.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="B-Ware Settings"
        Height="420" Width="480"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#FAFAFA">

    <Grid Margin="40">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Firebase URL -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="Firebase Database URL"
                       FontWeight="SemiBold"
                       Foreground="#333333"
                       Margin="0,0,0,8"/>
            <TextBox x:Name="UrlTextBox"
                     Padding="10,8"
                     FontSize="13"
                     BorderBrush="#CCCCCC"
                     BorderThickness="1"
                     TextChanged="UrlTextBox_TextChanged"/>
            <TextBlock x:Name="ErrorLabel"
                       Foreground="#D32F2F"
                       FontSize="12"
                       Margin="0,4,0,0"
                       Visibility="Collapsed"/>
        </StackPanel>

        <!-- Client ID -->
        <StackPanel Grid.Row="1" Margin="0,0,0,20">
            <TextBlock Text="Client ID"
                       FontWeight="SemiBold"
                       Foreground="#333333"
                       Margin="0,0,0,8"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="ClientIdTextBox"
                         Grid.Column="0"
                         IsReadOnly="True"
                         Padding="10,8"
                         FontSize="13"
                         FontFamily="Consolas"
                         Background="#F5F5F5"
                         BorderBrush="#CCCCCC"
                         BorderThickness="1"/>
                <Button x:Name="CopyButton"
                        Grid.Column="1"
                        Content="Copy"
                        Padding="16,8"
                        Margin="8,0,0,0"
                        Click="CopyButton_Click"/>
            </Grid>
        </StackPanel>

        <!-- Start with Windows -->
        <StackPanel Grid.Row="2" Margin="0,0,0,20">
            <CheckBox x:Name="LaunchAtLoginCheckBox"
                      Content="Start B-Ware when Windows starts"
                      FontSize="13"
                      Foreground="#333333"/>
        </StackPanel>

        <!-- Version Info -->
        <StackPanel Grid.Row="3" Margin="0,0,0,20">
            <TextBlock Text="Version"
                       FontWeight="SemiBold"
                       Foreground="#333333"
                       Margin="0,0,0,4"/>
            <TextBlock x:Name="VersionLabel"
                       FontSize="12"
                       Foreground="#888888"/>
        </StackPanel>

        <!-- Buttons -->
        <StackPanel Grid.Row="5"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button x:Name="CancelButton"
                    Content="Cancel"
                    Padding="20,10"
                    Margin="0,0,10,0"
                    Click="CancelButton_Click"/>
            <Button x:Name="SaveButton"
                    Content="Save"
                    Padding="20,10"
                    Background="#2196F3"
                    Foreground="White"
                    BorderThickness="0"
                    Click="SaveButton_Click">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Cursor" Value="Hand"/>
                    </Style>
                </Button.Style>
            </Button>
        </StackPanel>
    </Grid>
</Window>
