<Window x:Class="BWare.UI.SetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Welcome to B-Ware"
        Height="400" Width="480"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#FAFAFA">

    <Grid Margin="40">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0"
                   Text="Welcome to B-Ware!"
                   FontSize="24"
                   FontWeight="SemiBold"
                   Foreground="#333333"
                   Margin="0,0,0,8"/>

        <TextBlock Grid.Row="1"
                   Text="Enter your Firebase Database URL to get started."
                   FontSize="13"
                   Foreground="#666666"
                   TextWrapping="Wrap"
                   Margin="0,0,0,24"/>

        <!-- Firebase URL -->
        <StackPanel Grid.Row="2" Margin="0,0,0,20">
            <TextBlock Text="Firebase Database URL"
                       FontWeight="SemiBold"
                       Foreground="#333333"
                       Margin="0,0,0,8"/>
            <TextBox x:Name="UrlTextBox"
                     Padding="10,8"
                     FontSize="13"
                     BorderBrush="#CCCCCC"
                     BorderThickness="1"
                     TextChanged="UrlTextBox_TextChanged"/>
            <TextBlock x:Name="ErrorLabel"
                       Foreground="#D32F2F"
                       FontSize="12"
                       Margin="0,4,0,0"
                       Visibility="Collapsed"/>
        </StackPanel>

        <!-- Client ID -->
        <StackPanel Grid.Row="3" Margin="0,0,0,20">
            <TextBlock Text="Your Client ID"
                       FontWeight="SemiBold"
                       Foreground="#333333"
                       Margin="0,0,0,8"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="ClientIdTextBox"
                         Grid.Column="0"
                         IsReadOnly="True"
                         Padding="10,8"
                         FontSize="13"
                         FontFamily="Consolas"
                         Background="#F5F5F5"
                         BorderBrush="#CCCCCC"
                         BorderThickness="1"/>
                <Button x:Name="CopyButton"
                        Grid.Column="1"
                        Content="Copy"
                        Padding="16,8"
                        Margin="8,0,0,0"
                        Click="CopyButton_Click"/>
            </Grid>
            <TextBlock Text="Share this ID with your team members."
                       FontSize="12"
                       Foreground="#888888"
                       Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Get Started Button -->
        <Button x:Name="GetStartedButton"
                Grid.Row="6"
                Content="Get Started"
                Padding="20,12"
                FontSize="14"
                FontWeight="SemiBold"
                HorizontalAlignment="Right"
                Background="#2196F3"
                Foreground="White"
                BorderThickness="0"
                IsEnabled="False"
                Click="GetStartedButton_Click">
            <Button.Style>
                <Style TargetType="Button">
                    <Setter Property="Cursor" Value="Hand"/>
                    <Style.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Button.Style>
        </Button>
    </Grid>
</Window>
